+      fdl[i] = fdl[i - 1];
+      ddl[i] = ddl[i - 1];
+    }
+    fdl[0] = ffin;
+    ddl[0] = dfin;
+#ifndef __SYNTHESIS__
+    idle = prog ? 0 : idle + 1;
+    if (idle > 100000000L) {
+      printf("sbuf: no input for 1e8 iterations (%d tiles left to fill, %d to drain)\n", fleft + 1, dleft + 1);
+      exit(9);
+    }
+#endif
+    if (fin) break;
+  }
+}
