+      fh = !fh;
+      frq = tl.mask ? RQW : 0;
+      fmore = fleft != 0;
+      fnv_m1 = fleft == 1 ? last_m1 : NTT - 1;
+      fvb_m1 = fnv_m1 < TB ? fnv_m1 : TB - 1;
+      fleft--;
+    }
